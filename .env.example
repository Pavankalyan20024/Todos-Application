HOST=127.0.0.1
PORT=8000
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/taskflow
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://127.0.0.1:8000
ENVIRONMENT=development

# Optional SMTP values for password-reset email delivery.
EMAIL_FROM=TaskFlow <no-reply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
